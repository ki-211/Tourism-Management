# 复制为同目录下的 application-secret.yml 后填写，该文件不会被提交，也不会打进镜像。
# 只在 local 环境加载；这里的值会覆盖 application-local.yml。
spring:
  datasource:
    username: root
    password: change-me
    # 数据库不在本机或库名不同时，可以整体覆盖连接串：
    # url: jdbc:mysql://192.168.1.10:3306/tourism?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
