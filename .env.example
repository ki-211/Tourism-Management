# 生产环境示例。复制为 .env 后填写，切勿提交真实值。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tourism
DB_USERNAME=tourism
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes-base64
CORS_ALLOWED_ORIGINS=https://travel.example.edu.cn
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=tourism
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PATH_STYLE=false
AMAP_WEB_KEY=change-me
PUBLIC_BASE_URL=https://travel.example.edu.cn
HTTP_PORT=80
