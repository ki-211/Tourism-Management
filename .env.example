# 生产环境示例。复制为 .env 后填写，切勿提交真实值。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tourism
DB_USERNAME=tourism
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password
REDIS_PASSWORD=change-redis-password
JWT_SECRET=replace-with-at-least-32-random-bytes-base64
CORS_ALLOWED_ORIGINS=https://activity.example.com
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=tourism
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# compose.yaml 内置 MinIO，必须使用路径风格；外部 AWS S3 可改为 false。
S3_PATH_STYLE=true
AMAP_WEB_KEY=change-me
VITE_AMAP_JS_KEY=
AMAP_H5_SECURITY_JS_CODE=
AMAP_H5_SERVICE_HOST=
PUBLIC_BASE_URL=https://activity.example.com
HTTP_PORT=8088
